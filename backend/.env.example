# Supabase Configuration (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key
SUPABASE_BUCKET=caraxes-files

# CORS Allowed Origins (comma-separated list of allowed frontend URLs)
FRONTEND_ORIGIN=https://your-frontend.vercel.app,http://localhost:5173

# Google Gemini API Key (for RAG analysis, text audit, and OCR)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# OCR Engine: use "gemini" for cloud deployments (Render, Railway, Docker); "paddle" for local
OCR_BACKEND=gemini

# Optional: Demo Passcode for public demos (leave blank to disable)
DEMO_PASSCODE=

# Optional: GitHub PR Webhook Governance
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
